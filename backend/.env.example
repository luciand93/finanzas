# Copia este archivo a .env y rellena con tus valores

# Gemini API Key (obtén en https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=tu-api-key-aqui

# Supabase (obtén en https://app.supabase.com/project/_/settings/api)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-key-aqui

# Opcional: conexión directa a Postgres (para aplicar migraciones desde script)
# Puedes obtenerla en Supabase → Project Settings → Database → Connection string
SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres

# Opcional: Configuración adicional
ALLOWED_ORIGINS=*
NODE_ENV=development
